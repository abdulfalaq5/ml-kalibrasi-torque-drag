POSTGRES_DB=tdml
POSTGRES_USER=tdml
POSTGRES_PASSWORD=ganti-dengan-password-panjang-dan-acak
APP_ENV=production
MAX_UPLOAD_MB=100
SECRET_KEY=isi-string-acak-minimal-32-karakter
SESSION_HOURS=8
COOKIE_SECURE=true
ADMIN_USERNAME=admin
# Hanya untuk membuat akun pertama kali. HAPUS baris ini setelah akun terbentuk.
ADMIN_PASSWORD=isi-password-awal
# Impor massal dari folder (opsional; bawaan sudah diatur di docker-compose.yml)
# INBOX_MIN_AGE_S=60      # file yang baru diubah < 60 detik dilewati
# INBOX_MOVE=true         # pindahkan file ke data/processed atau data/rejected setelah impor
